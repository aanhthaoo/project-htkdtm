# Sao chép tệp này thành `.env` rồi đổi mật khẩu. KHÔNG commit tệp `.env`.
# Các giá trị dưới đây chỉ dùng cho môi trường phát triển trên máy cá nhân.

TZ=Asia/Ho_Chi_Minh

# --- PostgreSQL ---
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=bi_dw
POSTGRES_PORT=5432
# Tài khoản chỉ đọc schema dw (cho Superset) và tài khoản ứng dụng (đọc dw, ghi app)
BI_READONLY_PASSWORD=change_me_readonly
BI_APP_PASSWORD=change_me_app

# --- Backend (FastAPI) ---
BACKEND_PORT=8000

# --- Frontend (React) ---
FRONTEND_PORT=5173

# --- Superset ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change_me_superset_secret_key_at_least_32_chars
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin

# --- n8n ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key
