# Sao chép tệp này thành `.env` rồi đổi mật khẩu. KHÔNG commit tệp `.env`.
# Các giá trị dưới đây chỉ dùng cho môi trường phát triển trên máy cá nhân.

TZ=Asia/Ho_Chi_Minh

# --- PostgreSQL ---
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=bi_dw
POSTGRES_PORT=5432
# Tài khoản chỉ đọc schema dw (cho Superset) và tài khoản ứng dụng (đọc dw, ghi app)
BI_READONLY_PASSWORD=change_me_readonly
BI_APP_PASSWORD=change_me_app

# --- Backend (FastAPI) ---
BACKEND_PORT=8000

# --- Frontend (React) ---
FRONTEND_PORT=5173

# --- Superset ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change_me_superset_secret_key_at_least_32_chars
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin

# --- n8n ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key

# --- Xác thực website (backend) ---
# JWT_SECRET và SERVICE_KEY: chuỗi ngẫu nhiên dài (ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_TTL_MINUTES=60
# Khóa dịch vụ cho webhook nội bộ giữa n8n, bộ chạy ETL và backend (header X-Service-Key)
SERVICE_KEY=change_me_service_key
# Tài khoản quản trị tạo sẵn khi backend khởi động lần đầu (đổi mật khẩu ngay)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change_me_admin_web
# Tài khoản nhà đầu tư mẫu tạo sẵn để thử giao diện (bỏ trống để không tạo)
APP_DEMO_EMAIL=investor@example.com
APP_DEMO_PASSWORD=change_me_investor_web

# --- Bộ chạy ETL (dịch vụ etl-runner) ---
ETL_RUNNER_PORT=8100

# Tài khoản chủ sở hữu n8n (tạo bằng: python src/n8n/setup_owner.py). Mật khẩu cần chữ hoa, chữ thường, số, tối thiểu 8 ký tự
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=ChangeMe-n8n-1
