{
  "id": "etl-hourly",
  "name": "ETL - Thu thập tin RSS theo giờ",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Mỗi giờ",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "name": "Chạy thủ công",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ETL_RUNNER_URL }}/jobs/rss",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{ $env.SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "trigger",
              "value": "n8n"
            },
            {
              "name": "requested_by",
              "value": "n8n-hourly"
            }
          ]
        }
      },
      "name": "Thu thập RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ [202, 409].includes($json.statusCode) }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Đã nhận hoặc đang bận?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {},
      "name": "Xong",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        780,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/etl/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{ $env.SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job: 'rss', status: 'failed', message: String($json.error ? $json.error.message : JSON.stringify($json.body)).slice(0, 500) }) }}"
      },
      "name": "Ghi lỗi vào nhật ký",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        200
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Mỗi giờ": {
      "main": [
        [
          {
            "node": "Thu thập RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chạy thủ công": {
      "main": [
        [
          {
            "node": "Thu thập RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Thu thập RSS": {
      "main": [
        [
          {
            "node": "Đã nhận hoặc đang bận?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Đã nhận hoặc đang bận?": {
      "main": [
        [
          {
            "node": "Xong",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ghi lỗi vào nhật ký",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Ho_Chi_Minh"
  },
  "pinData": {}
}
